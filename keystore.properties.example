# Solo Ledger — release signing configuration (EXAMPLE)
#
# Copy this file to `keystore.properties` in the project root and fill in
# your real values. The real `keystore.properties` file is git-ignored and
# must NEVER be committed.
#
# For CI (GitHub Actions), these values are supplied via repository secrets
# instead of this file — see CONTRIBUTING.md / .github/workflows/release.yml.

storeFile=keystore/solo-ledger-release.p12
storePassword=YOUR_STORE_PASSWORD
keyAlias=solo-ledger
keyPassword=YOUR_KEY_PASSWORD
